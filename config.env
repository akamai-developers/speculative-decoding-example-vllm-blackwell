PROJECT_ROOT="/root/vllm-speculative-demo"
LOG_DIR="/root/vllm-speculative-demo/logs"
MODELS_DIR="/root/vllm-speculative-demo/models"

#TARGET_MODEL_HF="nvidia/Llama-3.1-70B-Instruct-FP8"
TARGET_MODEL_HF="meta-llama/Llama-3.1-8B-Instruct"
DRAFT_MODEL_HF="meta-llama/Llama-3.2-3B-Instruct"

# Dynamically resolve local model paths based on HF names
TARGET_MODEL="$MODELS_DIR/$(basename "$TARGET_MODEL_HF")"
DRAFT_MODEL="$MODELS_DIR/$(basename "$DRAFT_MODEL_HF")"

# Server Configurations
DTYPE="bfloat16"
MAX_MODEL_LEN=2048