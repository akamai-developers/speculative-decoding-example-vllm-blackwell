PROJECT_ROOT="/root/vllm-speculative-demo"
LOG_DIR="/root/vllm-speculative-demo/logs"
MODELS_DIR="/root/vllm-speculative-demo/models"

#TARGET_MODEL_HF:"Qwen/Qwen2.5-14B-Instruct"
#DRAFT_MODEL_HF: "Qwen/Qwen2.5-0.5B-Instruct"

TARGET_MODEL_HF="meta-llama/Llama-3.1-8B-Instruct"
DRAFT_MODEL_HF="meta-llama/Llama-3.2-1B-Instruct"

TARGET_MODEL="$MODELS_DIR/$(basename "$TARGET_MODEL_HF")"
DRAFT_MODEL="$MODELS_DIR/$(basename "$DRAFT_MODEL_HF")"

# Number of tokens the draft model proposes per step (k).
# The Streamlit app reads this too, to compute mean acceptance length.
NUM_SPEC_TOKENS=5

# ------------------------------------------------------------------------------
# Server profiles. Pick one when starting the servers:
#   ./scripts/start_vllm.sh demo12   # Demos 1-2: one request at a time, long context
#   ./scripts/start_vllm.sh demo3    # Demo 3: concurrency
#
# Both servers share one GPU, so the two GPU_UTIL values must add up to < ~0.92.
# The speculative server gets a larger slice because the draft model's weights and
# KV cache live inside it. Equal slices would NOT give equal KV-cache room.
# ------------------------------------------------------------------------------

# Demos 1-2
DEMO12_BASELINE_GPU_UTIL="0.35"
DEMO12_SPEC_GPU_UTIL="0.45"
DEMO12_MAX_MODEL_LEN="36864"
DEMO12_MAX_NUM_SEQS="1"

# Demo 3
DEMO3_BASELINE_GPU_UTIL="0.40"
DEMO3_SPEC_GPU_UTIL="0.50"
DEMO3_MAX_MODEL_LEN="8192"
DEMO3_MAX_NUM_SEQS="32"
