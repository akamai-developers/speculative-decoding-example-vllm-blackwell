# -------------------------
# Models
# -------------------------
MODELS_DIR=./models

TARGET_MODEL_HF=nvidia/Llama-3.1-70B-Instruct-FP8 #meta-llama/Llama-3.1-8B-Instruct
TARGET_MODEL=$MODELS_DIR/$(basename "$TARGET_MODEL_HF")

DRAFT_MODEL_HF=meta-llama/Llama-3.2-3B-Instruct #meta-llama/Llama-3.2-1B-Instruct
DRAFT_MODEL=$MODELS_DIR/$(basename "$DRAFT_MODEL_HF")

# -------------------------
# vLLM runtime settings
# -------------------------
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.15
MAX_MODEL_LEN=2048
TEMPERATURE=0.1
NUM_SPECULATIVE_TOKENS=4

# -------------------------
# vLLM serving
# -------------------------
INSTANCE_IP=$(hostname -I | awk '{print $1}')

BASELINE_URL="http://${INSTANCE_IP}:8000/v1/chat/completions"
SPEC_URL="http://${INSTANCE_IP}:8001/v1/chat/completions"
SPEC_METRICS_URL="http://${INSTANCE_IP}:8001/metrics"