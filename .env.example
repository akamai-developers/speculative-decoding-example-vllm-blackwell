# Project directory
export PROJECT_ROOT="/root/vllm-speculative-demo"
export LOG_DIR="$PROJECT_ROOT/logs"
export MODELS_DIR="./models"

# Model
export TARGET_MODEL_HF="nvidia/Llama-3.1-70B-Instruct-FP8"
export DRAFT_MODEL_HF="meta-llama/Llama-3.2-3B-Instruct"

# vLLM serving
export INSTANCE_IP=$(hostname -I | awk '{print $1}')

export BASELINE_URL="http://${INSTANCE_IP}:8000/v1/chat/completions"
export SPEC_URL="http://${INSTANCE_IP}:8001/v1/chat/completions"
export SPEC_METRICS_URL="http://${INSTANCE_IP}:8001/metrics"